    "    df_encoded[col] = df_encoded[col].map(freq_map)\n",
    "\n",
    "print(f\"   ✓ {len(freq_cols)} columnas de frecuencia codificadas\")\nprint(f\"     Mapeo: Never→0, Rarely→1, Sometimes→2, Very frequently→3\")"
