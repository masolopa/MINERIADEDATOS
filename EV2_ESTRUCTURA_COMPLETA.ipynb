    "        print(f\"   ✓ {col}: Sí→1, No→0\")\n",
    "\n",
    "# ====== 2. LABEL ENCODING (Variables con muchas categorías) ======\n",
    "print(\"\\n2️⃣ Codificando variables categóricas (Label Encoding):\")\n",
    "\n",
    "# Streaming service\n",
    "le_streaming = LabelEncoder()\n",
    "streaming_unique = df_encoded['Primary streaming service'].unique()\n",
    "df_encoded['Primary streaming service'] = le_streaming.fit_transform(df_encoded['Primary streaming service'])\n",
    "print(f\"   ✓ Primary streaming service:\")\nfor i, val in enumerate(le_streaming.classes_):\n",
    "    print(f\"      {val} → {i}\")\n",
    "\n",
    "# Género\n",
    "le_genre = LabelEncoder()\n",
    "df_encoded['Fav genre'] = le_genre.fit_transform(df_encoded['Fav genre'])\n",
    "print(f\"   ✓ Fav genre: {df_encoded['Fav genre'].nunique()} géneros codificados\")\n",
    "\n",
    "# Efecto de la música (VARIABLE OBJETIVO)\n",
    "le_effects = LabelEncoder()\n",
    "music_effects_unique = df_encoded['Music effects'].unique()\n",
    "df_encoded['Music effects'] = le_effects.fit_transform(df_encoded['Music effects'])\n",
    "print(f\"   ✓ Music effects (VARIABLE OBJETIVO):\")\nfor i, val in enumerate(le_effects.classes_):\n",
    "    print(f\"      {val} → {i}\")"
