   "source": [
    "print(\"=\"*80)\n",
    "print(\"ANÁLISIS DE ENTROPÍA\")\n",
    "print(\"=\"*80)\n",
    "\nprint(\"\\n📚 Concepto de Entropía:\")\nprint(\"  La entropía mide cuánta 'incertidumbre' o 'desorden' hay en los datos.\")\nprint(\"  • Entropía = 0: Datos perfectamente ordenados (1 sola clase)\")\nprint(\"  • Entropía = máx: Datos completamente mezclados (clases equiprobables)\")\nprint(\"  Fórmula: H(X) = -Σ(p_i * log2(p_i))\")\n",
    "\n# Calcular entropía de la variable objetivo\nvalue_counts = df_work['Music effects'].value_counts()\nprobs = value_counts / len(df_work)\nentropy_target = entropy(probs, base=2)\n",
    "\nprint(f\"\\n📊 Entropía de Music Effects: {entropy_target:.3f}\")\nprint(f\"   Máxima entropía posible: {np.log2(len(value_counts)):.3f}\")\nprint(f\"   Ratio: {entropy_target / np.log2(len(value_counts)):.1%}\")\nprint(f\"\\n   Interpretación: Los datos están {entropy_target / np.log2(len(value_counts)):.1%} distribuidos\")\nprint(f\"   (100% = Perfectamente balanceado)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ====== ENTROPÍA POR VARIABLE CATEGÓRICA ======\nprint(\"\\n📊 Entropía de Variables Categóricas:\")\nprint(\"─\"*80)\n",
    "\ncategorical_cols = df_work.select_dtypes(include=['object']).columns\nentropy_results = []\n",
    "\nfor col in categorical_cols:\n",
    "    value_counts = df_work[col].value_counts()\n",
    "    probs = value_counts / len(df_work)\n",
    "    ent = entropy(probs, base=2)\n",
    "    max_ent = np.log2(len(value_counts))\n",
    "    normalized_ent = ent / max_ent if max_ent > 0 else 0\n",
    "    \n",
    "    entropy_results.append({\n",
    "        'Variable': col,\n",
    "        'Entropía': ent,\n",
    "        'Max_Entropía': max_ent,\n",
    "        'Ratio': normalized_ent\n",
    "    })\n",
    "    \n",
    "    print(f\"\\n{col}:\")\n",
    "    print(f\"  Entropía: {ent:.3f}\")\n",
    "    print(f\"  Distribución: {normalized_ent:.1%}\")\n",
    "\nentropy_df = pd.DataFrame(entropy_results).sort_values('Entropía', ascending=False)\nprint(\"\\n\" + \"─\"*80)\nprint(\"\\n📈 Ranking por Entropía:\")\nprint(entropy_df.to_string(index=False))"
   ]
